
# Verify AWS Identity
aws sts get-caller-identity

# Verify Region
aws configure get region

# Set Region
aws configure set region us-east-1

# Verify S3 Access
aws s3 ls --no-verify-ssl

# Create SQS Dead Letter Queue
aws sqs create-queue --queue-name pearl-outbound-trigger-dlq-dev --region us-east-1 --no-verify-ssl

# Create Main SQS Queue
aws sqs create-queue --queue-name pearl-outbound-trigger-queue-dev --region us-east-1 --no-verify-ssl

# List SQS Queues
aws sqs list-queues --region us-east-1 --no-verify-ssl

# Get SQS Queue URL
aws sqs get-queue-url --queue-name pearl-outbound-trigger-queue-dev --region us-east-1 --no-verify-ssl

# Get SQS Queue ARN
aws sqs get-queue-attributes --queue-url <QUEUE_URL> --attribute-names QueueArn --region us-east-1 --no-verify-ssl

# List Step Functions
aws stepfunctions list-state-machines --region us-east-1 --no-verify-ssl

# List Lambda Functions
aws lambda list-functions --region us-east-1 --no-verify-ssl

# Upload Test Payload to S3
aws s3 cp test-payload.json s3://dev-individualandclient-pearl-canonical-us-east-1/9898/test-payload.json --region us-east-1 --no-verify-ssl

# Poll SQS Queue
aws sqs receive-message --region us-east-1 --queue-url <QUEUE_URL> --max-number-of-messages 5 --wait-time-seconds 10 --no-verify-ssl

# Build Lambda JAR
mvn clean package